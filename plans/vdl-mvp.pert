project VDL_MVP:
  version 5
  title "vdl MVP — design-aligned video download CLI"
  description |
    Implements the finalized architecture thought (vdl-architecture):
    ResourceKind routing (video / index / html / unknown),
    SQLite download registry with URL + m3u8 fingerprint dedupe,
    HTML scrape + interactive selection, HLS via ffmpeg, CLI surface.
    Existing src/vdl prototype is treated as a draft; converge to design.
  as_of 2026-08-02
  duration_unit hour
  finish RELEASED

resource DEV:
  title "Developer"
  capacity 1

# ---------------------------------------------------------------------------
# Milestones
# ---------------------------------------------------------------------------

milestone NOW:
  title "Now — architecture design finalized (llmthink vdl-architecture)"
  state reached

milestone GAP_BASELINED:
  title "Prototype vs design gap baselined"

milestone FOUNDATION_DONE:
  title "Registry + classification foundation done"

milestone MEDIA_PATHS_DONE:
  title "Direct video + m3u8 paths done"

milestone HTML_PATH_DONE:
  title "HTML scrape + selection UX done"

milestone CLI_DONE:
  title "CLI commands and options match design D11/D12"

milestone QUALITY_DONE:
  title "Tests and docs done"

milestone RELEASED:
  title "MVP accepted"

# ---------------------------------------------------------------------------
# 1. Gap analysis
# ---------------------------------------------------------------------------

task GAP_AUDIT NOW -> GAP_BASELINED:
  title "Audit src/vdl against design decisions D1-D15"
  description |
    Map each design decision to current code; list gaps (MPD error,
    failed-not-duplicate SQL, fingerprint rules, CLI flags, tests).
  duration 1h
  status done
  priority 100
  requires:
    DEV 1

# ---------------------------------------------------------------------------
# 2. Foundation (serialized by single DEV; explicit order via milestones)
# ---------------------------------------------------------------------------

task REGISTRY_IMPL GAP_BASELINED -> FOUNDATION_DONE:
  title "Harden registry (D5, D6, D7, EV8)"
  description |
    Ensure completed-only lookup with correct SQL parentheses;
    fingerprint + URL is_downloaded; failed does not block retry;
    schema matches design columns; add focused unit tests.
  duration 2h
  status done
  priority 90
  requires:
    DEV 1

task CLASSIFY_IMPL GAP_BASELINED -> FOUNDATION_DONE:
  title "Harden ResourceKind classification (D1, EV4)"
  description |
    content-type > body sniff > extension > bare path as html;
    unknown fallback behavior; unit tests for matrix cases.
  duration 2h
  status done
  priority 85
  requires:
    DEV 1

# ---------------------------------------------------------------------------
# 3. Media paths (both need foundation; both feed MEDIA_PATHS_DONE)
# ---------------------------------------------------------------------------

task VIDEO_IMPL FOUNDATION_DONE -> MEDIA_PATHS_DONE:
  title "Direct video path (D2)"
  description |
    Stream download, progress, hash, registry complete/skip/force.
  duration 2h
  status done
  priority 80
  requires:
    DEV 1

task M3U8_IMPL FOUNDATION_DONE -> MEDIA_PATHS_DONE:
  title "m3u8 path (D3, D10, PD1 boundary)"
  description |
    Master variant quality selection; media fingerprint;
    ffmpeg -c copy with bsf fallback; MPD explicit unsupported error;
    live/encrypted out of scope messaging.
  duration 3h
  status done
  priority 80
  requires:
    DEV 1

# ---------------------------------------------------------------------------
# 4. HTML (re-enters media paths)
# ---------------------------------------------------------------------------

task HTML_IMPL MEDIA_PATHS_DONE -> HTML_PATH_DONE:
  title "HTML scrape and selection (D4, D8, D9)"
  description |
    Extract candidates from tags/meta/jsonld/script;
    show 済/新規 with registry id+path; selection new/all/ranges;
    re-enter video/index pipelines with source_type=from_html.
  duration 3h
  status done
  priority 75
  requires:
    DEV 1

# ---------------------------------------------------------------------------
# 5. CLI surface
# ---------------------------------------------------------------------------

task CLI_IMPL HTML_PATH_DONE -> CLI_DONE:
  title "CLI surface alignment (D11, D12, D13)"
  description |
    get/list/status/info/open-dir; --home -q -f -H -y --all --timeout;
    module boundaries: cli -> service -> adapters/registry.
  duration 1h
  status done
  priority 70
  requires:
    DEV 1

# ---------------------------------------------------------------------------
# 6. Quality (tests + docs, both needed for QUALITY_DONE)
# ---------------------------------------------------------------------------

task TEST_IMPL CLI_DONE -> QUALITY_DONE:
  title "Regression tests for registry, classify, scrape, e2e"
  description |
    Unit tests without network; local http.server integration for
    video skip, m3u8 real segment, html candidate table.
  duration 3h
  status done
  priority 60
  requires:
    DEV 1

task DOCS_IMPL CLI_DONE -> QUALITY_DONE:
  title "Sync README with design and usage"
  description |
    Document three URL modes, registry paths, selection UX, non-goals.
    Link docs/design/vdl-architecture.dsl.
  duration 1h
  status done
  priority 50
  requires:
    DEV 1

# ---------------------------------------------------------------------------
# 7. Acceptance
# ---------------------------------------------------------------------------

task E2E_VERIFY QUALITY_DONE -> RELEASED:
  title "Manual acceptance of D1-D15 scenarios"
  description |
    Run acceptance checklist: direct video, duplicate skip, m3u8,
    html select, force re-download, status/list, VDL_HOME isolation.
  duration 2h
  status done
  priority 40
  requires:
    DEV 1

